# Copy this file to `.env` and fill in values before running Docker.
# Do NOT commit your real `TELEGRAM_BOT_TOKEN` to version control.

# Telegram bot token (required)
TELEGRAM_BOT_TOKEN=""

# Default language code (en / am / om)
DEFAULT_LANG=en

# Optional: logging
LOG_LEVEL=INFO

# Keep Python output unbuffered (recommended for Docker logs)
PYTHONUNBUFFERED=1
